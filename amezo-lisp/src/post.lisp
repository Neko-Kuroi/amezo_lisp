;;;; post.lisp - amezo.py のメイン処理 (投稿の受付とレス表示)
(in-package :amezo)

;;; ---------- フォーム解析 ----------
(defun parse-params (s &key (string-input t))
  "QUERY_STRING を alist にする (値は url-decode 済み、キーはそのまま)。重複キーは最初のもの。"
  (let ((out '()))
    (when (and s (plusp (length s)))
      (dolist (pair (split-string s #\&))
        (when (plusp (length pair))
          (multiple-value-bind (k v) (split-once pair #\=)
            (push (cons k (url-decode (or v ""))) out)))))
    (nreverse out)))

(defun parse-form-body (octs)
  "POST 本体 (octet) を (values alist trip用パスワード) にする。Python 版 main の前処理と同じ:
   見えない文字の除去、name の最初の # で分割、HTML エスケープ、改行の正規化。"
  (let ((form '()) (trip-pw ""))
    (when octs
      (loop for start from 0 below (length octs)
            for amp = (position (char-code #\&) octs :start start)
            for pair = (subseq octs start (or amp (length octs)))
            do (let ((eq (position (char-code #\=) pair)))
                 (when eq
                   (let* ((key (utf8-decode (subseq pair 0 eq)))
                          (value (url-decode (subseq pair (1+ eq)))))
                     (setf value (strip-invisible value))
                     (when (string= key "name")
                       (let ((p (position #\# value)))
                         (when p
                           (setf trip-pw (remove-if (lambda (c) (<= (char-code c) #x1f)) (subseq value (1+ p)))
                                 value (subseq value 0 p)))))
                     (setf value (html-escape value))
                     (setf value (replace-all (replace-all value (format nil "~a~a" #\Return #\Newline) (string #\Return))
                                              (string #\Newline) (string #\Return)))
                     (when (string= key "comm")
                       (setf value (replace-all value (string #\Return) "<br>")))
                     (setf value (remove-if (lambda (c) (<= (char-code c) #x1f)) value))
                     (push (cons key value) form))))
               (if amp (setf start amp) (return))))
    (values (nreverse form) trip-pw)))

(defun form-get (form key) (or (cdr (assoc key form :test #'string=)) ""))

(defun count-occurrences (needle s)
  (let ((n 0) (pos 0))
    (loop for p = (search needle s :start2 pos) while p do (incf n) (setf pos (+ p (length needle))))
    n))

(defun collapse-gt (s)
  "正規表現 &gt;(&gt;)+ -> &gt; 相当。"
  (with-output-to-string (out)
    (let ((i 0) (n (length s)))
      (loop while (< i n)
            do (if (and (<= (+ i 4) n) (string= "&gt;" s :start2 i :end2 (+ i 4)))
                   (progn (write-string "&gt;" out)
                          (loop while (and (<= (+ i 4) n) (string= "&gt;" s :start2 i :end2 (+ i 4))) do (incf i 4)))
                   (progn (write-char (char s i) out) (incf i)))))))

(defun remove-ng (word s)
  (replace-all s (html-escape word) ""))

;;; ---------- レス表示 ----------
(defun res-view (folder form)
  (let ((res (form-get form "res")))
    (unless (digits-p res) (page-error "不正なスレッド指定です"))
    (let ((from-idx (max 1 (or (safe-integer (form-get form "from")) 1)))
          (file-path (app-path folder (format nil "~a.html" res))))
      (unless (probe-file file-path) (thread-missing folder res "表示"))
      (let* ((lines (read-file-lines file-path))
             (fol-tag (format nil "<input type=\"hidden\" name=\"folder\" value=\"~a\">" (html-escape folder)))
             (out (make-string-output-stream)))
        (labels ((fixj (line) (replace-all line "href=\"../jump.cgi?" "href=\"jump.cgi?"))
                 (form-line (line)
                   (replace-all (replace-all line "action=\"../" "action=\"") "</form>" (format nil "~a</form>" fol-tag)))
                 (fixbase (line)
                   (fixj (replace-all (replace-all line "href=\"../style.css\"" "href=\"style.css\"")
                                      "src=\"../hide.js\"" "src=\"hide.js\""))))
          (let ((idx 0) (matched nil) (footer nil))
            ;; <dl> か <dt> を含む行まで (置換して) 出す
            (loop while (< idx (length lines))
                  for line = (nth idx lines)
                  do (write-string (fixbase line) out) (terpri out) (incf idx)
                     (when (or (search "<dl>" line) (search "<dt>" line)) (return)))
            ;; from 以上の最初のレスを探す
            (loop while (< idx (length lines))
                  for line = (nth idx lines)
                  do (when (starts-with-p "<form" line) (setf footer line))
                     (let ((dt (search "<dt>" line)))
                       (when dt
                         (let ((num (handler-case (parse-integer line :start (+ dt 4) :junk-allowed t) (error () nil))))
                           (when (and num (>= num from-idx))
                             (write-string (fixj line) out) (terpri out) (setf matched t) (incf idx) (return)))))
                     (incf idx))
            (when (and (not matched) footer)
              (write-string (form-line footer) out) (terpri out))
            (loop while (< idx (length lines))
                  for line = (nth idx lines)
                  do (write-string (if (search "</form>" line) (form-line line) (fixj line)) out) (terpri out) (incf idx)))
          (bail (html-header-response (get-output-stream-string out))))))))

;;; ---------- 日付パース (二重カキコ判定用) ----------
(defun parse-prev-post (line)
  "前のレス行から (values 名前 本文)。取れなければ NIL。"
  (let ((b1 (search "投稿者：<font" line)))
    (when b1
      (let ((bs (search "><b>" line :start2 b1)))
        (when bs
          (let ((be (search " </b>" line :start2 bs)))
            (when be
              (let ((dd (search "<dd>" line :start2 be)))
                (when dd
                  (let ((de (search " </dl>" line :start2 dd)))
                    (when de (values (subseq line (+ bs 4) be) (subseq line (+ dd 4) de)))))))))))))

;;; ---------- メイン ----------
(defun handle-amezo (req)
  (let ((*request* req))
    (handler-case (amezo-main req)
      (bbs-exit (e) (bbs-exit-response e)))))

(defun amezo-main (req)
  (let ((body (request-body req)))
    (let ((content-len (if body (length body) 0)))
      (when (< content-len 0) (page-error "投稿内容が不正です"))
      (when (> content-len *max-post-bytes*) (page-error "投稿内容が大きすぎます")))
    (let ((query-params (parse-params (request-query-string req))))
      (multiple-value-bind (form trip-pw) (parse-form-body body)
        (let ((folder (form-get form "folder")))
          (when (string= folder "") (setf folder (or (cdr (assoc "folder" query-params :test #'string=)) "")))
          (when (string= folder "")
            (let ((referer (url-decode (request-header req "Referer"))))
              (setf referer (replace-all referer "://www." "://"))
              ;; https?://[^/]+/([^/]+)/ の単純版
              (let ((p (search "://" referer)))
                (when p
                  (let ((slash (position #\/ referer :start (+ p 3))))
                    (when slash
                      (let ((slash2 (position #\/ referer :start (1+ slash))))
                        (when slash2 (setf folder (subseq referer (1+ slash) slash2))))))))))
          (when (string= folder "") (page-error "板名が判定できません。"))
          (when (or (find #\/ folder) (search ".." folder) (not (is-board folder)))
            (page-error "板名が不正です"))
          (let ((name (form-get form "name")) (mail (form-get form "mail"))
                (comm (form-get form "comm")) (subj (form-get form "subj"))
                (res (form-get form "res")))
            (unless (or (string= res "") (digits-p res)) (page-error "不正なスレッド指定です"))
            (when (and (assoc "sub" form :test #'string=) (plusp (length (form-get form "sub"))))
              (res-view folder form))
            ;; ページ指定
            (let* ((page-raw (if (assoc "page" form :test #'string=) (form-get form "page")
                                 (or (cdr (assoc "page" query-params :test #'string=)) "")))
                   (next-raw (if (assoc "next" form :test #'string=) (form-get form "next")
                                 (or (cdr (assoc "next" query-params :test #'string=)) "")))
                   (page (cond ((digits-p page-raw 1 6) (parse-integer page-raw))
                               ((digits-p next-raw 1 6) (1+ (floor (1- (max 1 (parse-integer next-raw))) *per-page*)))
                               (t 1))))
              (setf page (page-clamp folder page))
              (let ((reload-flag nil))
                (when (and (string= name subj) (string= name comm)) (setf reload-flag t))
                (when (and (string= name "") (string= subj "") (string= comm "")) (setf reload-flag t))
                (when (> (count-occurrences "<br>" comm) *comm-lines-max*) (page-error "改行が多すぎます"))
                (when (> (html-chars-len (replace-all comm "<br>" (string #\Newline))) *comm-max*)
                  (page-error "コメントが長すぎます"))
                (when (> (html-chars-len mail) *mail-max*) (page-error "メールが長すぎます"))
                (setf subj (remove-if (lambda (c) (or (char= c #\Space) (char= c #\u3000) (char= c #\uFF3F))) subj))
                (when (> (html-chars-len subj) *subj-max*) (page-error "題名が長すぎます"))
                (setf name (replace-all (replace-all name *trip-mark* "◇") *cap-mark* "☆"))
                (setf name (remove-name-spaces name))
                (setf name (ccut name *name-max*))
                (setf comm (collapse-gt comm))
                ;; NG ワード
                (when (probe-file (app-path "ng.txt"))
                  (dolist (line (read-file-lines (app-path "ng.txt") '()))
                    (unless (string= line "")
                      (let* ((parts (split-string line #\,))
                             (ng (first parts)) (opt (or (second parts) "")))
                        (unless (string= ng "")
                          (cond ((string= opt "n") (when (search (html-escape ng) name) (setf reload-flag t)))
                                ((string= opt "c") (when (search (html-escape ng) comm) (setf reload-flag t)))
                                (t (setf name (remove-ng ng name) comm (remove-ng ng comm)
                                         mail (remove-ng ng mail) subj (remove-ng ng subj)))))))))
                (when (and (= page 1) (not reload-flag))
                  (let ((cap-ok (is-cap name trip-pw)))
                    (unless cap-ok
                      (setf name (replace-all name (html-escape *admin-name*) (format nil "＃~a" *admin-name*))))
                    (when (plusp (length res)) (setf subj ""))
                    (when (string= name "") (page-error "投稿者を記入してください"))
                    (when (string= comm "") (page-error "コメントが入力されていません"))
                    (when (and (string= res "") (string= subj "")) (page-error "題名が入力されていません"))
                    (let ((left (post-interval-left folder)))
                      (when (plusp left)
                        (page-error (format nil "連投を検知しました。あと ~d 秒ほど待ってから投稿してください" left))))
                    (let ((ip (client-ip)))
                      (when (plusp (length subj)) (check-global-ip ip))
                      (setf comm (linkify-urls comm))
                      (let ((trip ""))
                        (if cap-ok
                            (setf name (concatenate 'string name *cap-mark*))
                            (progn (setf trip (make-trip trip-pw))
                                   (when (plusp (length trip)) (setf name (format nil "~a~a~a" name *trip-mark* trip)))))
                        (when (plusp (length mail))
                          (setf name (format nil "<a href=\"mailto:~a \">~a </a>" mail name)))
                        (let* ((now (epoch-now))
                               (post-id (make-id ip folder now))
                               (date-str (format-jst-date now)))
                          (when (string= res "") (setf res (format-res-number now)))
                          (post-write folder res subj name comm trip post-id date-str form)))
                      )))
                (multiple-value-bind (index-name status) (regen-index folder :page page :reload-flag reload-flag)
                  (declare (ignore status))
                  (redirect-response folder index-name))))))))))

(defun post-write (folder res subj name comm trip post-id date-str form)
  "スレッドファイルへの書き込み (新規作成 / 返信)。ロックの中で行う。"
  (let* ((new-thread (plusp (length subj)))
         (file-path (app-path folder (format nil "~a.html" res))))
    (when new-thread
      ;; O_EXCL で作る。重複したら番号を足して30回まで (Python 版と同じ)
      (let ((created nil))
        (loop for try from 0 to 30
              do (setf file-path (app-path folder (format nil "~a.html" res)))
                 (cond ((or (probe-file (app-path folder (format nil "x~a.html" res)))
                            (archived-exists folder res))
                        nil)
                       (t (let ((fd (fd-open file-path :flags (logior sb-posix:o-rdwr sb-posix:o-creat sb-posix:o-excl) :mode #o644)))
                            (when fd (fd-close fd) (setf created t)))))
                 (when created (return))
                 (when (>= try 30) (page-error "スレッドを作成できません."))
                 (setf res (format nil "~d" (1+ (parse-integer res))))))
      (write-file-string file-path ""))
    (unless (probe-file file-path) (thread-missing folder res "返信"))
    ;; ファイル自体を flock して書き込む
    (let ((done nil) (nlink-zero nil))
      (call-with-fd-lock file-path
                         (lambda (fd)
                           ;; ロック待ちの間に archive が名前を消していたら (nlink=0) 書かない
                           (if (and (not new-thread) (zerop (file-nlink-of-fd fd)))
                               (setf nlink-zero t)
                               (setf done (write-post-under-lock folder res subj name comm trip post-id date-str form file-path new-thread))))
                         :timeout 10)
      (when nlink-zero (thread-missing folder res "返信"))
      (unless done (page-error "スレッドがありません.")))))

(defun write-post-under-lock (folder res subj name comm trip post-id date-str form file-path new-thread)
  (let ((locked (and (not new-thread) (thread-is-locked folder res))))
    (when locked
      (let ((given (form-get form "key")))
        (when (string= given "")
          (page-error "このスレッドは認証キーが必要です。ページを再読み込みして、認証キーの欄に入力してください。"))
        (unless (key-verify folder res given)
          (page-error "認証キーが正しくありません。"))))
    (let* ((lines (read-file-lines file-path))
           (cnt 0) (pos-lines 0) (prev ""))
      ;; <dt>N のある行を数え、最後のその行までを保持対象にする (Python 版の tell の位置)
      (loop for line in lines
            for dt = (search "<dt>" line)
            do (if (null dt) (return)
                   (let ((num (handler-case (parse-integer line :start (+ dt 4) :junk-allowed t) (error () nil))))
                     (if (null num) (return)
                         (setf cnt num prev line pos-lines (1+ pos-lines))))))
      (incf cnt)
      (multiple-value-bind (pname pcomm) (parse-prev-post prev)
        (when (and pname (string= name pname) (string= comm pcomm))
          (page-error "二重カキコです.")))
      (let* ((subj1 (if new-thread
                        (format nil "<html><head><meta charset=\"UTF-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><title>~a </title><link rel=\"stylesheet\" href=\"../style.css\">~a</head><body>"
                                subj *script-tag*)
                        ""))
             (subj2 (if new-thread (format nil "<font size=+2 color=red><b>~a </b></font>" subj) ""))
             (meta (format nil "<font size=-1 class=\"meta\" data-id=\"~a\"~a>"
                           post-id (if (plusp (length trip)) (format nil " data-trip=\"~a\"" trip) "")))
             (new-line (format nil "~a<dl><dt>~d~a投稿者：<font color=forestgreen><b>~a </b></font>~a　投稿日：~a ID:~a</font><br><dd>~a </dl>"
                               subj1 cnt subj2 name meta date-str post-id comm))
             (kept (subseq lines 0 pos-lines))
             (content (with-output-to-string (out)
                        (dolist (l kept) (write-string l out) (terpri out))
                        (write-string new-line out) (terpri out)
                        (write-string (reply-form res :locked locked) out)
                        (write-string "</body></html>" out) (terpri out))))
        (write-file-string file-path content)
        (touch-lasttime folder)
        t))))
