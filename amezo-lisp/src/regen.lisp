;;;; regen.lisp - 板 index の再生成と過去ログ一覧 (Python 版 amezo.regen_index 周辺)
(in-package :amezo)

;;; ---------- 過去ログ一覧 (kako) ----------
(defun kako-list-size (folder)
  (or (file-size-of (app-path folder *kako-list*)) -1))

(defun append-kako-list (folder items)
  "退避した [(時刻文字列 名前)] の題名を kako.txt に追記する。"
  (let ((buf (with-output-to-string (out)
               (dolist (item (sort (copy-list items) (lambda (a b) (or (string< (car a) (car b))
                                                                       (and (string= (car a) (car b)) (string< (cdr a) (cdr b)))))))
                 (format out "~a~a~a~%" (cdr item) *kako-sep*
                         (read-thread-title (or (archived-path folder (cdr item)) (app-path folder (cdr item)))))))))
    (handler-case
        (progn (call-with-fd-lock (app-path folder *kako-list*)
                                  (lambda (fd) (declare (ignore fd)) (append-file-string (app-path folder *kako-list*) buf))
                                  :timeout 5)
               t)
      (error () nil))))

(defun rebuild-kako-list (folder names)
  (let ((items '()))
    (dolist (name names)
      (let ((mt (or (file-mtime-of (or (archived-path folder name) (app-path folder name))) 0)))
        (push (cons (format nil "~11,'0d" mt) name) items)))
    (setf items (sort items (lambda (a b) (or (string< (car a) (car b))
                                              (and (string= (car a) (car b)) (string< (cdr a) (cdr b)))))))
    (let ((path (app-path folder *kako-list*))
          (content (with-output-to-string (out)
                     (dolist (item items)
                       (format out "~a~a~a~%" (cdr item) *kako-sep*
                               (read-thread-title (or (archived-path folder (cdr item)) (app-path folder (cdr item)))))))))
      (handler-case (progn (write-file-atomic path content) t) (error () nil)))))

(defun reverse-file-lines (path)
  "ファイルの行を新しい順 (逆順) に返す。"
  (reverse (read-file-lines path '())))

(defun write-kako (folder body-tag title0 amezo-name suffix title)
  (let ((list-path (app-path folder *kako-list*)))
    (unless (file-regular-p list-path) (return-from write-kako nil))
    (let ((content
            (with-output-to-string (out)
              (format out "<html><head><meta http-equiv=\"Content-Type\" content=\"text/html; charset=UTF-8\">~%<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">~%<link rel=\"stylesheet\" href=\"../style.css\">~%<title>~a~a~a 過去ログ</title></head>~%~a~a~%<font size=+2>~a~a~a 過去ログ</font>~%<div class=\"row links\"><a href=\"./\">板へ戻る</a></div>~%<font size=2>~%"
                      title0 amezo-name suffix *copyright* body-tag title amezo-name suffix)
              (let ((i 0))
                (dolist (line (reverse-file-lines list-path))
                  (multiple-value-bind (name rest) (split-once line (char *kako-sep* 0))
                    ;; KAKO_SEP は "<>" (2文字)。split-once は1文字なのでここで直す
                    (declare (ignore name rest))
                    nil)
                  (let ((p (search *kako-sep* line)))
                    (when p
                      (let ((name (subseq line 0 p)) (ttl (subseq line (+ p (length *kako-sep*)))))
                        (when (and (> (length name) 5) (starts-with-p "o" name) (ends-with-p ".html" name)
                                   (digits-p (subseq name 1 (- (length name) 5))))
                          (incf i)
                          (format out " ~d<a href=\"~a\">~a</a>~%" i name ttl)))))))
              (format out "</font>~%<hr></body></html>~%"))))
      (ignore-errors (write-file-atomic (app-path folder *kako-file*) content)))))

;;; ---------- スレッド走査 ----------
(defun thread-file-name-p (name)
  (and (> (length name) 5) (ends-with-p ".html" name) (digits-p (subseq name 0 (- (length name) 5)))))

(defun old-file-name (name)
  "o数字.html / o数字.html.gz のどちらかなら、'o数字.html' を返す。"
  (let ((base (if (ends-with-p ".gz" name) (subseq name 0 (- (length name) 3)) name)))
    (and (> (length base) 6) (starts-with-p "o" base) (ends-with-p ".html" base)
         (digits-p (subseq base 1 (- (length base) 5)))
         base)))

(defun scan-threads (folder &key (want-old t))
  "戻り値: (values スレッド[(時刻文字列 . 名前)] 新しい順, 過去ログ名のリスト)"
  (let ((files '()) (old-names '()) (old-seen '()))
    (dolist (name (list-dir-names (app-path folder)))
      (cond ((thread-file-name-p name)
             (let ((mt (or (file-mtime-of (app-path folder name)) 0)))
               (push (cons (format nil "~11,'0d" mt) name) files)))
            (want-old
             (let ((o (old-file-name name)))
               (when (and o (not (member o old-seen :test #'string=)))
                 (push o old-seen) (push o old-names))))))
    (setf files (sort files (lambda (a b) (or (string> (car a) (car b))
                                              (and (string= (car a) (car b)) (string> (cdr a) (cdr b)))))))
    (values files old-names)))

(defun count-threads (folder)
  (let ((n 0))
    (dolist (name (list-dir-names (app-path folder)))
      (when (thread-file-name-p name) (incf n)))
    (if (plusp *max-threads*) (min n *max-threads*) n)))

(defun total-pages (n) (max 1 (ceiling n *per-page*)))

(defun page-clamp (folder page)
  (if (<= page 1) 1 (min page (total-pages (count-threads folder)))))

(defun pager-html (folder page total)
  (if (<= total 1)
      ""
      (let ((q (url-encode folder)))
        (labels ((href (p) (if (= p 1) "./" (format nil "../amezo.cgi?folder=~a&amp;page=~d" q p))))
          (let ((nums '()) (last-p 0))
            (loop for p from 1 to total
                  do (when (or (<= total 10) (= p 1) (= p total) (<= (abs (- p page)) 2))
                       (when (and (plusp last-p) (> (- p last-p) 1)) (push "…" nums))
                       (push (if (= p page) (format nil "<b>[~d]</b>" p) (format nil "<a href=\"~a\">~d</a>" (href p) p)) nums)
                       (setf last-p p)))
            (setf nums (nreverse nums))
            (let ((segments '()))
              (when (> page 1) (push (format nil "<a href=\"~a\">← 前の~d件</a>" (href (1- page)) *per-page*) segments))
              (push (join-strings nums " ") segments)
              (when (< page total) (push (format nil "<a href=\"~a\">次の~d件 →</a>" (href (1+ page)) *per-page*) segments))
              (format nil "<div class=\"row links pager\">~a</div>~%" (join-strings (nreverse segments) "　"))))))))

(defun read-thread-excerpt (path)
  "戻り値: (values 先頭行 最後の7レスのリスト レス行数)。読めなければ NIL。"
  (handler-case
      (let ((lines (read-file-lines path)))
        (when lines
          (let* ((first (car lines))
                 (rest (cdr lines))
                 (body '()))
            (dolist (l rest)
              (when (starts-with-p "<form" l) (return))
              (push l body))
            (setf body (nreverse body))
            (values first (subseq body (max 0 (- (length body) 7))) (length body)))))
    (error () nil)))

(defun strip-board-tags (line)
  "板 index 用に、先頭行から html/head/body/meta/link/title/script を取り除く。"
  (let ((s line))
    ;; <title>...</title> と <script...></script> (中身ごと)
    (loop for a = (search "<title>" s) while a
          for b = (search "</title>" s :start2 a)
          do (setf s (if b (concatenate 'string (subseq s 0 a) (subseq s (+ b 8))) (subseq s 0 a))))
    (loop for a = (search "<script" s) while a
          for b = (search "</script>" s :start2 a)
          do (setf s (if b (concatenate 'string (subseq s 0 a) (subseq s (+ b 9))) (subseq s 0 a))))
    ;; 単独タグ </?(html|head|body)...> と <(meta|link)...>
    (with-output-to-string (out)
      (let ((i 0) (n (length s)))
        (loop while (< i n)
              do (if (char= (char s i) #\<)
                     (let ((end (position #\> s :start i))
                           (tag nil))
                       (when end
                         (let ((inside (subseq s (1+ i) (min end (+ i 8)))))
                           (cond ((or (starts-with-p "html" inside) (starts-with-p "/html" inside)
                                      (starts-with-p "head" inside) (starts-with-p "/head" inside)
                                      (starts-with-p "body" inside) (starts-with-p "/body" inside)
                                      (starts-with-p "meta" inside) (starts-with-p "link" inside))
                                  (setf tag t)))))
                       (if (and end tag)
                           (setf i (1+ end))
                           (progn (write-char (char s i) out) (incf i))))
                     (progn (write-char (char s i) out) (incf i))))))))

(defun board-view-info (folder)
  "regen 用の見た目情報 (plist)。"
  (multiple-value-bind (color title) (board-info folder)
    (let* ((suffix (if (string= folder "main") "(メイン)" ""))
           (bg-attr "")
           (bang (position #\! color)))
      (when bang (setf bg-attr (format nil " background=\"~a\"" (subseq color (1+ bang)))
                     color (subseq color 0 bang)))
      (let ((text-attr ""))
        (when (ends-with-p "*" color)
          (setf text-attr " text=\"#ffffff\" link=\"red\" vlink=\"orange\"" color (subseq color 0 (1- (length color)))))
        (setf title (replace-all title "#c#" ","))
        (let ((title0 title) (amezo-name *amezo-name*))
          (let ((a (search "alt=\"" title0)))
            (when a
              (let ((b (position #\" title0 :start (+ a 5))))
                (when b (setf title0 (subseq title0 (+ a 5) b) amezo-name "")))))
          (list :title0 title0 :amezo-name amezo-name :suffix suffix :bg-attr bg-attr
                :color color :text-attr text-attr :title title))))))

(defun write-index-page (out folder page total files v)
  (let ((pager (pager-html folder page total))
        (start (* (1- page) *per-page*)))
    (format out "<html><head><meta http-equiv=\"Content-Type\" content=\"text/html; charset=UTF-8\">~%<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">~%<link rel=\"stylesheet\" href=\"../style.css\">~a~%<title>~a~a~a</title></head>~%~a<body~a bgcolor=\"~a\"~a>~%<font size=+2>~a~a~a</font>~%"
            *script-tag* (getf v :title0) (getf v :amezo-name) (getf v :suffix) *copyright*
            (getf v :bg-attr) (getf v :color) (getf v :text-attr)
            (getf v :title) (getf v :amezo-name) (getf v :suffix))
    (let ((header (read-file-string (app-path "header.html"))))
      (when header (write-string header out)))
    (format out "~a<font size=2>~%<!-- HEAD LINE -->~%" pager)
    (loop for i from start below (+ start *headline-count*)
          while (< i (length files))
          for fname = (cdr (nth i files))
          for ttl = (let ((fl (read-file-lines (app-path folder fname))))
                      (and fl (extract-first-b (car fl))))
          do (format out " ~d<a href=\"~a\">~a</a>~%" (1+ i) fname (or ttl "")))
    (format out "<!-- HEAD LINE END -->~%</font>~%")
    (when (plusp (kako-list-size folder))
      (format out "<div class=\"row links\"><a href=\"~a\">過去ログ</a></div>~%" *kako-file*))
    (loop for i from start below (+ start *per-page*)
          while (< i (length files))
          for fname = (cdr (nth i files))
          do (format out "<table border=1 cellspacing=1 cellpadding=2 width=100% bgcolor=\"#efefef\"><tr><td><font color=\"#000000\">~%")
             (multiple-value-bind (first lines n-lines) (read-thread-excerpt (app-path folder fname))
               (when first (write-string (strip-board-tags first) out) (terpri out))
               (dolist (l lines) (write-string l out) (terpri out))
               (let* ((res-id (subseq fname 0 (- (length fname) 5)))
                      (sub-tag (if (and n-lines (> n-lines 200))
                                   (format nil "<input type=text name=\"from\" value=\"~d\" size=\"4\"><input type=submit name=\"sub\" value=\"〜\"> " (- n-lines 98))
                                   ""))
                      (links (format nil "<div class=\"row links\"><a href=\"~a.html\">レス全部を見る</a> ~a<a href=\"#top\">上へ</a> <a href=\"./\">リロード</a></div>" res-id sub-tag)))
                 (format out "</font></td></tr></table>~%~a<hr>~%"
                         (reply-form res-id :links links :locked (thread-is-locked folder res-id))))))
    (format out "~a<hr></body></html>~%" pager)))

(defun replace-index (tmp-path index-path)
  (handler-case
      (progn (chmod-file tmp-path (or (handler-case (logand (sb-posix:stat-mode (sb-posix:stat (namestring index-path))) #o7777) (error () nil)) #o644))
             (sb-posix:rename (namestring tmp-path) (namestring index-path))
             t)
    (error () (ignore-errors (delete-file tmp-path)) (page-error "indexを更新できません."))))

(defun regen-index (folder &key (page 1) reload-flag (use-cache t))
  "戻り値: (values index名 状態文字列) 状態は \"done\" / \"cached\" / \"busy\"。"
  (setf page (max 1 page))
  (let ((v (board-view-info folder)))
    ;; ---- 2ページ目以降 ----
    (when (> page 1)
      (let ((files (nth-value 0 (scan-threads folder :want-old nil))))
        (when (plusp *max-threads*) (setf files (subseq files 0 (min (length files) *max-threads*))))
        (let ((total (total-pages (length files))))
          (when (> page total) (setf page total))
          (when (= page 1) (return-from regen-index (regen-index folder :page 1 :reload-flag t :use-cache use-cache)))
          (let* ((index-name (format nil "index~d.html" page))
                 (index-path (app-path folder index-name)))
            (when (and use-cache (plusp *page-cache*))
              (let ((mt (file-mtime-of index-path)))
                (when (and mt (< (- (epoch-now) mt) *page-cache*))
                  (return-from regen-index (values index-name "cached")))))
            (let ((tmp (format nil "~a.tmp~d" (namestring index-path) (sb-posix:getpid)))
                  (content (with-output-to-string (out) (write-index-page out folder page total files v))))
              (write-file-string tmp content)
              (replace-index tmp index-path)
              (return-from regen-index (values index-name "done")))))))
    ;; ---- 1ページ目 ----
    (let* ((index-name "index.html")
           (index-path (app-path folder index-name)))
      (when (and use-cache reload-flag (plusp *post-interval*))
        (let ((mt (file-mtime-of index-path)))
          (when (and mt (< (- (epoch-now) mt) *post-interval*))
            (return-from regen-index (values index-name "cached")))))
      (let ((lock-path (app-path folder "regen.lock")) (locked nil))
        (let ((fd (fd-open lock-path)))
          (unless fd (page-error "ロックファイルを作成できません."))
          (unwind-protect
               (progn
                 (if reload-flag
                     (setf locked (fd-lock fd :nonblocking t))
                     (progn (loop repeat 100 do (setf locked (fd-lock fd :nonblocking t)) (when locked (return)) (sleep 0.1))))
                 (unless locked (return-from regen-index (values index-name "busy")))
                 (multiple-value-bind (files old-names) (scan-threads folder :want-old (<= (kako-list-size folder) 0))
                   (let ((retired '()))
                     (when (plusp *max-threads*)
                       (let ((kept '()) (n 0))
                         (dolist (f files)
                           (incf n)
                           (if (> n *max-threads*)
                               (let ((res (subseq (cdr f) 0 (- (length (cdr f)) 5))))
                                 (unless (archived-exists folder res)
                                   (when (rename-path (app-path folder (cdr f)) (app-path folder (format nil "o~a" (cdr f))))
                                     (push (cons (car f) (format nil "o~a" (cdr f))) retired)
                                     (ignore-errors (delete-file (app-path folder (format nil "~a.lock" res)))))))
                               (push f kept)))
                         (setf files (nreverse kept))))
                     (setf retired (nreverse retired))
                     (let ((kako-changed nil))
                       (cond ((<= (kako-list-size folder) 0)
                              (when (or old-names retired)
                                (setf kako-changed (rebuild-kako-list folder (append old-names (mapcar #'cdr retired))))))
                             (retired (setf kako-changed (append-kako-list folder retired))))
                       (let ((has-kako (plusp (kako-list-size folder)))
                             (content (with-output-to-string (out)
                                        (write-index-page out folder 1 (total-pages (length files)) files v))))
                         (let ((tmp (format nil "~a.tmp~d" (namestring index-path) (sb-posix:getpid))))
                           (handler-case (write-file-string tmp content) (error () (page-error "indexを書き込めません.")))
                           (replace-index tmp index-path))
                         (when (and has-kako (or kako-changed (not (file-regular-p (app-path folder *kako-file*)))))
                           (write-kako folder (format nil "<body~a bgcolor=\"~a\"~a>" (getf v :bg-attr) (getf v :color) (getf v :text-attr))
                                       (getf v :title0) (getf v :amezo-name) (getf v :suffix) (getf v :title)))
                         ;; 古い「次のページ」ファイルの掃除
                         (dolist (name (list-dir-names (app-path folder)))
                           (when (and (> (length name) 6) (starts-with-p "index" name) (digit-char-p (char name 5))
                                      (ends-with-p ".html" name))
                             (let ((mt (file-mtime-of (app-path folder name))))
                               (when (and mt (> (- (epoch-now) mt) 600))
                                 (ignore-errors (delete-file (app-path folder name)))))))
                         )))))
            (fd-unlock fd) (fd-close fd)))
        (values index-name "done")))))
