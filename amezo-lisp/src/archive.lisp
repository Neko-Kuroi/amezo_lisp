;;;; archive.lisp - 過去ログの gzip 圧縮 (Python 版 archive.py)
;;;; gzip の作成・展開は外部の gzip コマンドを使う (中身の照合は自前の SHA-256)。
(in-package :amezo)

(defparameter *arch-lock-tries* 50)
(defparameter *arch-tmp-max-age* 86400)

;;; ---------- gzip 外部コマンド ----------
(defun gzip-decompress-to-file (gz out-path)
  "成功すれば T。out-path に展開結果を書く。"
  (handler-case
      (let ((proc (sb-ext:run-program "gzip" (list "-dc" (namestring gz))
                                      :output (namestring out-path) :if-output-exists :supersede
                                      :error nil :search t :wait t)))
        (and proc (zerop (sb-ext:process-exit-code proc))))
    (error () nil)))

(defun gzip-decompress-digest (gz)
  "(values hex 長さ) 展開しながら数える。開けなければ (values NIL NIL)。"
  (handler-case
      (let ((proc (sb-ext:run-program "gzip" (list "-dc" (namestring gz))
                                      :output :stream :error nil :search t :wait nil)))
        (if (null proc)
            (values nil nil)
            (let ((ctx (%make-sha256)) (n 0)
                  (buf (make-array 65536 :element-type '(unsigned-byte 8)))
                  (stream (sb-ext:process-output proc)))
              (loop for c = (read-sequence buf stream)
                    while (plusp c)
                    do (sha256-update ctx buf 0 c) (incf n c))
              (sb-ext:process-wait proc)
              (if (zerop (sb-ext:process-exit-code proc))
                  (values (hex-encode (sha256-final ctx)) n)
                  (values nil nil)))))
    (error () (values nil nil))))

(defun gzip-compress-file (plain tmp)
  (handler-case
      (let ((proc (sb-ext:run-program "gzip" (list "-6" "-c" (namestring plain))
                                      :output (namestring tmp) :if-output-exists :supersede
                                      :error nil :search t :wait t)))
        (and proc (zerop (sb-ext:process-exit-code proc))))
    (error () nil)))

(defun gz-isize (gz)
  (handler-case
      (let ((size (file-size-of gz)))
        (when (and size (>= size 4))
          (with-open-file (in gz :element-type '(unsigned-byte 8))
            (file-position in (- size 4))
            (let ((b (make-array 4 :element-type '(unsigned-byte 8))))
              (when (= (read-sequence b in) 4)
                (+ (aref b 0) (* (aref b 1) 256) (* (aref b 2) 65536) (* (aref b 3) 16777216)))))))
    (error () nil)))

(defun arch-mb (b) (format nil "~,2fMB" (/ b 1048576.0)))

;;; ---------- 走査 ----------
(defun arch-scan (folder)
  "(values 平文の名前リスト gzの名前リスト(o数字.html で) 一時ファイルのパスリスト) 番号順。"
  (let ((plain '()) (gz '()) (tmp '()))
    (dolist (name (list-dir-names (app-path folder)))
      (cond ((and (starts-with-p "o" name) (ends-with-p ".html" name)
                  (> (length name) 6) (digits-p (subseq name 1 (- (length name) 5))))
             (push name plain))
            ((and (starts-with-p "o" name) (ends-with-p ".html.gz" name)
                  (> (length name) 9) (digits-p (subseq name 1 (- (length name) 8))))
             (push (subseq name 0 (- (length name) 3)) gz))
            ((and (starts-with-p "o" name) (search ".html.gz.tmp" name)
                  (digits-p (subseq name 1 (position #\. name))))
             (push (app-path folder name) tmp))))
    (flet ((num (n) (parse-integer (subseq n 1 (position #\. n)))))
      (values (sort plain #'< :key #'num) (sort gz #'< :key #'num) tmp))))

;;; ---------- アーカイバ ----------
(defstruct archiver
  (quiet 600) (dry nil) (verbose nil)
  (compressed 0) (plain-removed 0) (stale-gz-removed 0) (quarantined 0) (ng 0)
  (in-bytes 0) (out-bytes 0) (skip (make-hash-table :test #'equal)))

(defun arch-say (a path msg)
  (declare (ignore a))
  (format t "~34a ~a~%" (if (starts-with-p "./" path) (subseq path 2) path) msg)
  (finish-output))

(defun arch-skip (a path reason)
  (incf (gethash reason (archiver-skip a) 0))
  (when (archiver-verbose a) (arch-say a path (format nil "skip: ~a" reason)))
  nil)

(defun arch-ng (a path msg)
  (incf (archiver-ng a))
  (arch-say a path (format nil "NG: ~a" msg))
  nil)

(defun disk-free-bytes (dir)
  "df コマンドで空き容量 (バイト) を取る。取れなければ NIL (sb-posix に statvfs が無い環境向け)。"
  (handler-case
      (let ((out (with-output-to-string (s)
                   (let ((p (sb-ext:run-program "df" (list "-P" "-B1" (namestring dir))
                                                :search t :wait t :output s :error nil)))
                     (unless (and p (zerop (sb-ext:process-exit-code p))) (return-from disk-free-bytes nil))))))
        (let* ((lines (split-string out #\Newline))
               (data (second lines)))
          (when data
            (let ((cols (remove "" (split-string data #\Space) :test #'string=)))
              (parse-integer (fourth cols) :junk-allowed t)))))
    (error () nil)))

(defun arch-stage1 (a plain)
  (let ((st-size (file-size-of plain)) (st-mtime (file-mtime-of plain)))
    (when (null st-size) (return-from arch-stage1 (arch-skip a plain "ファイルが無い")))
    (when (< (- (epoch-now) st-mtime) (archiver-quiet a))
      (return-from arch-stage1 (arch-skip a plain "最後の書き込みから間もない")))
    (let ((free (disk-free-bytes ".")))
      (when (and free (< free (+ st-size 1048576)))
        (return-from arch-stage1 (arch-skip a plain "ディスクの空きが足りない"))))
    (when (archiver-dry a)
      (arch-say a plain (format nil "[dry-run] 圧縮する (~a)" (arch-mb st-size)))
      (incf (archiver-compressed a))
      (return-from arch-stage1 t))
    (let* ((t0 (epoch-now))
           (gzpath (format nil "~a.gz" plain))
           (tmp (format nil "~a.tmp~d" gzpath (sb-posix:getpid))))
      (unless (gzip-compress-file plain tmp)
        (ignore-errors (delete-file tmp))
        (return-from arch-stage1 (arch-ng a plain "開けない (権限・空き容量を確認)")))
      (multiple-value-bind (src-hex src-n) (sha256-file plain)
        (multiple-value-bind (d-hex d-n) (gzip-decompress-digest tmp)
          (when (or (null d-hex) (string/= d-hex src-hex) (/= d-n src-n))
            (ignore-errors (delete-file tmp))
            (return-from arch-stage1 (arch-ng a plain "展開して確かめたら、元と一致しない (一時ファイルを消した)"))))
        (let ((st2-size (file-size-of plain)) (st2-mtime (file-mtime-of plain)))
          (when (or (null st2-size) (/= st2-size st-size) (/= st2-mtime st-mtime) (/= src-n st-size))
            (ignore-errors (delete-file tmp))
            (return-from arch-stage1 (arch-skip a plain "圧縮している間に元が変わった"))))
        (set-file-mtime tmp st-mtime)
        (chmod-file tmp #o644)
        (unless (rename-path tmp gzpath)
          (ignore-errors (delete-file tmp))
          (return-from arch-stage1 (arch-ng a plain "rename できない")))
        (let ((gsize (or (file-size-of gzpath) 0)))
          (incf (archiver-compressed a)) (incf (archiver-in-bytes a) st-size) (incf (archiver-out-bytes a) gsize)
          (arch-say a plain (format nil "圧縮  ~a → ~a (~,1f倍)  ~dms"
                                    (arch-mb st-size) (arch-mb gsize) (/ st-size (max 1 gsize))
                                    (round (* (- (epoch-now) t0) 1000))))
          t)))))

(defun arch-stage2 (a plain)
  (let* ((gzpath (format nil "~a.gz" plain))
         (sp-size (file-size-of plain)) (sp-mtime (file-mtime-of plain))
         (sg-mtime (file-mtime-of gzpath)) (sg-ctime (file-ctime-of gzpath)))
    (when (or (null sp-size) (null sg-mtime)) (return-from arch-stage2 nil))
    (when (/= sg-mtime sp-mtime)
      (if (archiver-dry a)
          (progn (arch-say a plain "[dry-run] 古い gz を削除する") (incf (archiver-stale-gz-removed a)))
          (progn (ignore-errors (delete-file gzpath))
                 (incf (archiver-stale-gz-removed a))
                 (arch-say a plain "古い gz を削除 (平文が圧縮のあとに更新された。次回に再圧縮する)")))
      (return-from arch-stage2 nil))
    (when (< (- (epoch-now) sg-ctime) (archiver-quiet a))
      (arch-skip a plain "gz の作成から間もない") (return-from arch-stage2 nil))
    (when (>= sp-size 4294967296)
      (arch-skip a plain "4GiB 以上は確認できない") (return-from arch-stage2 nil))
    (let ((isize (gz-isize gzpath)))
      (multiple-value-bind (dp-hex dp-n) (sha256-file plain)
        (multiple-value-bind (dg-hex dg-n) (gzip-decompress-digest gzpath)
          (when (or (null isize) (/= isize sp-size) (null dp-hex) (null dg-hex)
                    (string/= dp-hex dg-hex) (/= dp-n dg-n))
            (if (archiver-dry a)
                (progn (arch-say a plain "[dry-run] NG: gz の中身が平文と一致しない → gz を .bad に改名する")
                       (incf (archiver-ng a)))
                (progn (ignore-errors (rename-path gzpath (format nil "~a.bad" gzpath)))
                       (incf (archiver-quarantined a))
                       (arch-ng a plain "gz の中身が平文と一致しない。どちらも消さず、gz を oN.html.gz.bad に改名した (人が確認する)")))
            (return-from arch-stage2 nil)))))
    ;; 平文をロックして再確認してから消す
    (let ((fd (fd-open plain :flags sb-posix:o-rdonly)) (got nil))
      (when (null fd) (arch-skip a plain "ロックのために開けない") (return-from arch-stage2 nil))
      (loop repeat *arch-lock-tries* do (setf got (fd-lock fd :nonblocking t)) (when got (return)) (sleep 0.1))
      (unless got (fd-close fd) (arch-skip a plain "ロックが取れない (投稿中?)") (return-from arch-stage2 nil))
      (let* ((fst (ignore-errors (sb-posix:fstat fd)))
             (same (and fst (> (sb-posix:stat-nlink fst) 0)
                        (= (sb-posix:stat-size fst) sp-size) (= (sb-posix:stat-mtime fst) sp-mtime))))
        (unless same
          (fd-unlock fd) (fd-close fd)
          (arch-skip a plain "ロックを待つあいだに変わった (次回に判断する)")
          (return-from arch-stage2 nil))
        (if (archiver-dry a)
            (progn (fd-unlock fd) (fd-close fd)
                   (arch-say a plain "[dry-run] 平文を削除する") (incf (archiver-plain-removed a)))
            (let ((ok (ignore-errors (delete-file plain) t)))
              (fd-unlock fd) (fd-close fd)
              (if ok
                  (progn (incf (archiver-plain-removed a)) (arch-say a plain "平文を削除 (gz に置き換え)"))
                  (arch-ng a plain "平文を消せない"))))))))

;;; ---------- 自己チェック ----------
(defun arch-selftest (dirpath &key (full t))
  (let ((r '()))
    (flet ((add (label ok &optional (detail "")) (push (list label (and ok t) detail) r)))
      (add "gzip コマンドが使える" (gzip-compress-file (app-path "blist.txt") (format nil "~a/.arch-gz-test" (namestring dirpath))))
      (ignore-errors (delete-file (format nil "~a/.arch-gz-test" (namestring dirpath))))
      (let* ((base (format nil "~a/.archive-selftest-~d" (namestring dirpath) (sb-posix:getpid)))
             (a-path (format nil "~a.a" base)) (b-path (format nil "~a.b" base)))
        (unwind-protect
             (progn
               (handler-case (write-file-string a-path "selftest~%") (error () (add "フォルダに書き込める" nil dirpath) (return-from arch-selftest (nreverse r))))
               (add "フォルダに書き込める" t)
               (let ((fd (fd-open a-path :flags sb-posix:o-rdwr)))
                 (let ((s (sb-posix:fstat fd)))
                   (add "通常のファイルの nlink は 1" (= (sb-posix:stat-nlink s) 1) (format nil "nlink=~d" (sb-posix:stat-nlink s))))
                 (delete-file a-path)
                 (let ((s (sb-posix:fstat fd)))
                   (add "開いたまま unlink すると nlink が 0 になる" (zerop (sb-posix:stat-nlink s)) (format nil "nlink=~d" (sb-posix:stat-nlink s))))
                 (fd-close fd))
               (write-file-string a-path "selftest~%")
               (let ((fd (fd-open a-path :flags sb-posix:o-rdwr)))
                 (rename-path a-path b-path)
                 (let ((s (sb-posix:fstat fd)))
                   (add "開いたまま rename しても nlink は 1 のまま" (= (sb-posix:stat-nlink s) 1) (format nil "nlink=~d" (sb-posix:stat-nlink s))))
                 (fd-close fd))
               (set-file-mtime b-path 1700000000)
               (let ((s (ignore-errors (sb-posix:stat b-path))))
                 (add "os.utime で更新日時 (mtime) を指定できる" (and s (= (sb-posix:stat-mtime s) 1700000000)))
                 (let ((c0 (if s (sb-posix:stat-ctime s) 0)))
                   (when full (sleep 1))
                   (rename-path b-path a-path)
                   (let ((s2 (ignore-errors (sb-posix:stat a-path))))
                     (add "rename で ctime が更新され、mtime は保たれる"
                          (and s2 (if full (> (sb-posix:stat-ctime s2) c0) (>= (sb-posix:stat-ctime s2) c0))
                               (= (sb-posix:stat-mtime s2) 1700000000))
                          (format nil "ctime ~d → ~d" c0 (if s2 (sb-posix:stat-ctime s2) 0))))))
               ;; 別プロセスが持っている flock は取れないこと
               (let ((locked nil))
                 (handler-case
                     (let ((proc (sb-ext:run-program "flock" (list a-path "-c" "sleep 3") :search t :wait nil :output nil :error nil)))
                       (when proc
                         (sleep 0.5)
                         (let ((fd (fd-open a-path :flags sb-posix:o-rdwr)))
                           (when fd (setf locked (not (fd-lock fd :nonblocking t))) (fd-unlock fd) (fd-close fd)))
                         (sb-ext:process-kill proc 15) (sb-ext:process-wait proc)))
                   (error () nil))
                 (add "別プロセスが持っている flock は、こちらからは取れない" locked))
               (add "ディスクの空き容量が確認できる"
                    (not (null (disk-free-bytes ".")))))
          (ignore-errors (delete-file a-path)) (ignore-errors (delete-file b-path))))
      (nreverse r))))

;;; ---------- restore ----------
(defun arch-valid-board (b)
  (and (plusp (length b)) (not (find #\/ b)) (not (search ".." b)) (is-board b) (dir-exists-p (app-path b))))

(defun arch-usage ()
  (format *error-output* "使い方:~%  archive 板名… | --all [--quiet=秒] [--limit=件数] [--dry-run] [-v]~%  archive --restore 板名 oN~%  archive --selftest [板名]~%")
  2)

(defun arch-restore (folder oname)
  (let ((num (let ((s oname))
               (when (starts-with-p "o" s) (setf s (subseq s 1)))
               (when (ends-with-p ".html" s) (setf s (subseq s 0 (- (length s) 5))))
               (and (digits-p s) s))))
    (unless (and (arch-valid-board folder) num) (return-from arch-restore (arch-usage)))
    (let* ((plain (app-path folder (format nil "o~a.html" num)))
           (gzpath (format nil "~a.gz" (namestring plain))))
      (let ((lk (fd-open (app-path folder "archive.lock") :flags (logior sb-posix:o-wronly sb-posix:o-creat sb-posix:o-append))))
        (when (or (null lk) (not (fd-lock lk :nonblocking t)))
          (when lk (fd-close lk))
          (format *error-output* "板 ~a: 別の archive が実行中です~%" folder)
          (return-from arch-restore 2))
        (unwind-protect
             (progn
               (unless (file-regular-p gzpath) (format *error-output* "~a が無い~%" gzpath) (return-from arch-restore 2))
               (when (probe-file plain) (format *error-output* "~a がすでにある (上書きはしない)~%" (namestring plain)) (return-from arch-restore 2))
               (let* ((sg-mtime (file-mtime-of gzpath))
                      (tmp (format nil "~a.restore.tmp~d" (namestring plain) (sb-posix:getpid)))
                      (n 0))
                 (gzip-decompress-to-file gzpath tmp)
                 (setf n (or (file-size-of tmp) -1))
                 (when (/= n (or (gz-isize gzpath) -2))
                   (ignore-errors (delete-file tmp))
                   (format *error-output* "展開した長さが、gz の記録と一致しない (gz が壊れている?)~%")
                   (return-from arch-restore 1))
                 (set-file-mtime tmp sg-mtime)
                 (chmod-file tmp #o644)
                 (unless (rename-path tmp plain)
                   (ignore-errors (delete-file tmp))
                   (format *error-output* "rename できない~%")
                   (return-from arch-restore 1))
                 (format t "~a を作った (~a)。gz は残してある。~%" (namestring plain) (arch-mb n))
                 (format t "  編集すると更新日時が変わり、配信は平文に切り替わる (古い gz は次回の実行で消え、その次に再圧縮される)。~%")
                 (format t "  編集しなければ、次回以降の実行で、この平文はまた消える。~%")
                 0))
          (fd-unlock lk) (fd-close lk))))))

;;; ---------- メイン ----------
(defun archive-main (argv)
  (let ((opt-quiet *archive-quiet-seconds*) (opt-limit 0) (dry nil) (verbose nil)
        (all nil) (restore nil) (selftest nil) (boards '()))
    (dolist (a argv)
      (cond ((string= a "--all") (setf all t))
            ((string= a "--dry-run") (setf dry t))
            ((string= a "-v") (setf verbose t))
            ((string= a "--restore") (setf restore t))
            ((string= a "--selftest") (setf selftest t))
            ((and (starts-with-p "--quiet=" a) (digits-p (subseq a 8) 1 7) (<= (parse-integer (subseq a 8)) 604800))
             (setf opt-quiet (parse-integer (subseq a 8))))
            ((and (starts-with-p "--limit=" a) (digits-p (subseq a 8) 1 9) (>= (parse-integer (subseq a 8)) 1))
             (setf opt-limit (parse-integer (subseq a 8))))
            ((and (plusp (length a)) (char/= (char a 0) #\-)) (push a boards))
            (t (return-from archive-main (arch-usage)))))
    (setf boards (nreverse boards))
    (when restore
      (when (/= (length boards) 2) (return-from archive-main (arch-usage)))
      (return-from archive-main (arch-restore (first boards) (second boards))))
    (when all (setf boards (board-folders)))
    (when selftest
      (let* ((allb (board-folders))
             (b (or (first boards) (first allb))))
        (unless (and b (arch-valid-board b)) (return-from archive-main (arch-usage)))
        (let ((bad 0))
          (format t "自己チェック (フォルダ: ./~a)~%" b)
          (dolist (r (arch-selftest (app-path b)))
            (format t "~a~a~a~%" (if (second r) "OK   " "NG   ") (first r)
                    (if (plusp (length (third r))) (format nil "  (~a)" (third r)) ""))
            (unless (second r) (incf bad)))
          (format t "~a~%" (if (zerop bad) "すべて OK。この環境で archive を使えます。"
                               (format nil "NG が ~d 件。この環境では archive を動かさないでください。" bad)))
          (return-from archive-main (if (zerop bad) 0 2)))))
    (when (null boards) (return-from archive-main (arch-usage)))
    (dolist (b boards)
      (unless (arch-valid-board b)
        (format *error-output* "板 ~a: 見つからない (blist.txt とフォルダを確認)~%" b)
        (return-from archive-main 2)))
    (unless dry
      (let ((bad (remove-if #'second (arch-selftest (app-path (first boards)) :full nil))))
        (when bad
          (dolist (r bad) (format *error-output* "自己チェック NG: ~a~%" (first r)))
          (format *error-output* "この環境では動かしません。`archive --selftest 板名` で詳細を確認してください。~%")
          (return-from archive-main 2))))
    (let ((run (make-archiver :quiet opt-quiet :dry dry :verbose verbose))
          (remaining opt-limit))
      (dolist (folder boards)
        (let ((lk nil) (lk-fd nil))
          (unless dry
            (setf lk-fd (fd-open (app-path folder "archive.lock") :flags (logior sb-posix:o-wronly sb-posix:o-creat sb-posix:o-append)))
            (when (or (null lk-fd) (not (fd-lock lk-fd :nonblocking t)))
              (when lk-fd (fd-close lk-fd))
              (format t "板 ~a: 別の archive が実行中のため、スキップ~%" folder)
              (setf lk :skipped)))
          (unless (eq lk :skipped)
            (multiple-value-bind (plain gz tmps) (arch-scan folder)
              (unless dry
                (dolist (tp tmps)
                  (let ((mt (file-mtime-of tp)))
                    (when (and mt (> (- (epoch-now) mt) *arch-tmp-max-age*))
                      (ignore-errors (delete-file tp))
                      (format t "~a  古い一時ファイルを削除~%" (namestring tp))))))
              (let ((bc (list (archiver-compressed run) (archiver-plain-removed run) (archiver-stale-gz-removed run)
                              (archiver-quarantined run) (archiver-ng run) (archiver-in-bytes run) (archiver-out-bytes run))))
                (dolist (name plain)
                  (when (member name gz :test #'string=) (arch-stage2 run (format nil "./~a/~a" folder name))))
                (dolist (name plain)
                  (unless (member name gz :test #'string=)
                    (if (and (plusp opt-limit) (<= remaining 0))
                        (arch-skip run (format nil "./~a/~a" folder name) "--limit に達した")
                        (when (arch-stage1 run (format nil "./~a/~a" folder name))
                          (when (plusp opt-limit) (decf remaining))))))
                (flet ((d (i cur) (- cur (nth i bc))))
                  (format t "板 ~a: 圧縮 ~d (~a → ~a)、平文削除 ~d、古い gz 削除 ~d、gz を退避 ~d、NG ~d~%"
                          folder (d 0 (archiver-compressed run)) (arch-mb (d 5 (archiver-in-bytes run))) (arch-mb (d 6 (archiver-out-bytes run)))
                          (d 1 (archiver-plain-removed run)) (d 2 (archiver-stale-gz-removed run))
                          (d 3 (archiver-quarantined run)) (d 4 (archiver-ng run))))))
            (when lk-fd (fd-unlock lk-fd) (fd-close lk-fd)))))
      (when (plusp (hash-table-count (archiver-skip run)))
        (format t "スキップ: ~a~%"
                (join-strings (let ((parts '()))
                                (maphash (lambda (k v) (push (format nil "~a ~d" k v) parts)) (archiver-skip run))
                                (nreverse parts)) ", ")))
      (if (plusp (archiver-ng run)) 1 0))))
