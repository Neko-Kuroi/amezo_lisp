;;;; dai.lisp - 板一覧 + 各板の HEAD LINE (Python 版 dai.py)
(in-package :amezo)

(defparameter *headline-max* 20)

(defun read-headline (folder folder-escaped)
  (let ((lines (read-file-lines (app-path folder "index.html"))))
    (if (null lines)
        '()
        (let ((pos (position-if (lambda (l) (search "<!-- HEAD LINE -->" l)) lines)))
          (if (null pos)
              '()
              (let ((out '()))
                (loop for line in (subseq lines (1+ pos))
                      while (and (< (length out) *headline-max*) (not (search "<!-- HEAD LINE END -->" line)))
                      do (push (replace-first-digit-html line folder-escaped) out))
                (nreverse out)))))))

(defun replace-first-digit-html (line folder-escaped)
  "最初の 数字.html だけを folder/数字.html に変える (Perl の s/// 相当)。"
  (let ((n (length line)))
    (loop for i from 0 below n
          when (digit-char-p (char line i))
            do (let ((j i))
                 (loop while (and (< j n) (digit-char-p (char line j))) do (incf j))
                 (when (and (<= (+ j 5) n) (string= ".html" line :start2 j :end2 (+ j 5)))
                   (return (format nil "~a~a/~a" (subseq line 0 i) folder-escaped (subseq line i))))
                 (setf i j)))
    line))

(defun handle-dai (req)
  (declare (ignore req))
  (let ((out (make-string-output-stream)))
    (format out "<!DOCTYPE html>~%<html lang=\"ja\"><head>~%<meta charset=\"UTF-8\">~%<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">~%<base target=\"naka\">~%<link rel=\"stylesheet\" href=\"style.css\">~%<title>板一覧</title>~%</head><body>~%")
    (dolist (line (blist-lines))
      (unless (string= line "")
        (let* ((parts (split-string line #\,))
               (folder (first parts))
               (color (or (second parts) ""))
               (title (or (third parts) "")))
          (unless (or (string= folder "") (starts-with-p "." folder) (find #\/ folder) (search ".." folder))
            ;; 背景画像指定 (!…) と白文字指定 (*) は色ではない
            (let ((bang (position #\! color))) (when bang (setf color (subseq color 0 bang))))
            (when (ends-with-p "*" color) (setf color (subseq color 0 (1- (length color)))))
            (setf title (replace-all title "#c#" ","))
            (let ((folder-escaped (html-escape folder)) (color-escaped (html-escape color)))
              (format out "<table border=0 cellspacing=1 cellpadding=2 width=100% bgcolor=\"~a\"><tr><td>~%<a href=\"~a/\"><b><font size=\"3\" color=\"#F92500\">~a</font></b></a>~%"
                      color-escaped folder-escaped title)
              (dolist (hl (read-headline folder folder-escaped)) (write-string hl out) (terpri out))
              (format out "</td></tr></table>~%"))))))
    (format out "</body></html>~%")
    (html-header-response (get-output-stream-string out))))
