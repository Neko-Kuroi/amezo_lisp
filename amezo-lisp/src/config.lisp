;;; config.ini のスキーマ: 名前 -> (型 既定値 最小 最大)
(defun config-schema ()
  (list (list "AMEZO" :text "＠あめぞう" 0 40)
        (list "URLBASE" :url "http://ame.x0.com/" 0 200)
        (list "ADMIN" :text "サポート" 1 20)
        (list "POST_INTERVAL" :int 5 0 3600)
        (list "GLOBAL_WINDOW" :int 180 0 86400)
        (list "MAX_THREADS" :int 200 0 100000)
        (list "PAGE_CACHE" :int 10 0 3600)
        (list "MAX_POST_BYTES" :int 7500 1000 1000000)
        (list "SUBJ_MAX" :int 45 1 500)
        (list "NAME_MAX" :int 25 1 200)
        (list "MAIL_MAX" :int 50 1 500)
        (list "COMM_MAX" :int 400 1 10000)
        (list "COMM_LINES_MAX" :int 20 1 1000)
        (list "HASH_ITERATIONS" :int 100000 1000 5000000)
        (list "TRUSTED_PROXIES" :ips '("127.0.0.1" "::1") 0 16)
        (list "JUMP_ENABLED" :bool t 0 1)
        (list "ARCHIVE_QUIET_SECONDS" :int 600 0 604800)))

(defun config-check (type v min max)
  "1つの値を検査する。(values 通ったか 型を直した値または理由)"
  (case type
    (:int
     (let ((s (and (stringp v) (trim-space v))))
       (if (and s (plusp (length s)) (<= (length s) 12)
                (let ((body (if (char= (char s 0) #\-) (subseq s 1) s)))
                  (and (plusp (length body)) (every #'digit-char-p body))))
           (let ((n (parse-integer s)))
             (if (<= min n max) (values t n) (values nil (format nil "~d〜~d の範囲外です" min max))))
           (values nil "整数ではありません"))))
    (:bool
     (let ((l (and (stringp v) (string-downcase (trim-space v)))))
       (cond ((member l '("1" "true" "yes" "on") :test #'string=) (values t t))
             ((member l '("0" "false" "no" "off") :test #'string=) (values t nil))
             (t (values nil "true / false ではありません")))))
    (:text
     (cond ((not (stringp v)) (values nil "文字列ではありません"))
           ((find-if (lambda (c)
                       (let ((code (char-code c)))
                         (or (<= code #x1f) (= code #x7f) (find c "<>\"'&$\\"))))
                     v)
            (values nil "使えない文字 (制御文字 < > \" ' & $ \\) を含みます"))
           ((<= min (length v) max) (values t v))
           (t (values nil (format nil "~d〜~d 文字ではありません" min max)))))
    (:url
     (if (and (stringp v) (<= (length (utf8 v)) max)
              (or (string= v "")
                  (let ((ok t) (i 0))
                    ;; https?://[A-Za-z0-9][A-Za-z0-9.\-:/_]* の単純版
                    (setf i (cond ((starts-with-p "http://" v) 7)
                                  ((starts-with-p "https://" v) 8)
                                  (t (setf ok nil) 0)))
                    (when (and ok (or (>= i (length v)) (not (alphanumericp (char v i))))) (setf ok nil))
                    (when ok
                      (loop for j from i below (length v)
                            for c = (char v j)
                            unless (or (alphanumericp c) (find c ".-:/_")) do (setf ok nil)))
                    ok)))
         (values t v)
         (values nil "http:// か https:// で始まる URL ではありません")))
    (:ips
     (cond ((and (stringp v) (string= v "")) (values t '()))
           ((not (listp v)) (values nil "IP アドレスの並びではありません"))
           ((> (length v) max) (values nil "IP アドレスの並びではありません"))
           ((every (lambda (ip) (and (stringp ip) (ip-valid-p (trim-space ip)))) v)
            (values t (mapcar (lambda (ip) (trim-space ip)) v)))
           (t (values nil "IP アドレスではない値があります"))))
    (otherwise (values nil "未対応の型です"))))

(defun ini-clean-value (v)
  "INI の値の後処理: 引用符を外し、';' コメントを取り、空白を詰める。"
  (cond ((and (plusp (length v)) (char= (char v 0) #\"))
         (let ((end (position #\" v :start 1)))
           (if (and end (plusp end)) (subseq v 1 end) v)))
        (t
         (let ((p (search " ;" v)))
           (when p (setf v (subseq v 0 p))))
         (let ((p2 (search (format nil "~a;" #\Tab) v)))
           (when p2 (setf v (subseq v 0 p2))))
         (trim-space v))))

(defun parse-ini-raw (text)
  "INI の生の値を読む (展開はしない)。書き方の誤りがあれば :error。
   戻り値: alist キー -> 文字列 or 文字列のリスト。同じキーは最後の値 (KEY[] は積む)。"
  (let ((raw '()))
    (dolist (line (split-string text #\Newline))
      (let ((s (trim-space (string-right-trim '(#\Return) line))))
        (unless (or (string= s "") (char= (char s 0) #\;) (char= (char s 0) #\#))
          (when (or (char= (char s 0) #\[) (not (find #\= s)))
            (return-from parse-ini-raw :error))
          (multiple-value-bind (k v) (split-once s #\=)
            (setf k (trim-space k) v (trim-space v))
            (when (string= k "") (return-from parse-ini-raw :error))
            (let ((is-list (ends-with-p "[]" k)))
              (when is-list (setf k (trim-space (subseq k 0 (- (length k) 2)))))
              (setf v (ini-clean-value v))
              (let ((prev (assoc k raw :test #'string=)))
                (cond ((and is-list prev (listp (cdr prev)))
                       (setf (cdr prev) (append (cdr prev) (list v))))
                      ((and is-list prev) (setf (cdr prev) (list (cdr prev) v)))
                      (is-list (push (cons k (list v)) raw))
                      (prev (setf (cdr prev) v))
                      (t (push (cons k v) raw)))))))))
    (nreverse raw)))

(defun config-load (file)
  "config.ini を読み、検査を通った値だけを返す。(values alist 無視した理由のリスト)"
  (let ((path (if (pathnamep file) file (app-path file))))
    (cond ((not (file-regular-p path)) (values '() '()))
          (t
           (let ((text (read-file-string path)))
             (if (null text)
                 (values '() '("読み込めません (書き方の誤り)"))
                 (let ((raw (parse-ini-raw text)))
                   (if (eq raw :error)
                       (values '() '("読み込めません (書き方の誤り)"))
                       (let ((out '()) (errors '()))
                         (dolist (kv raw)
                           (let ((spec (assoc (car kv) (config-schema) :test #'string=)))
                             (if (null spec)
                                 (push (format nil "不明なキー: ~a" (car kv)) errors)
                                 (multiple-value-bind (ok val)
                                     (config-check (second spec) (cdr kv) (fourth spec) (fifth spec))
                                   (if ok
                                       (push (cons (car kv) val) out)
                                       (push (format nil "~a: ~a" (car kv) val) errors))))))
                         (values (nreverse out) (nreverse errors)))))))))))


(defparameter *config-vars*
  '(("AMEZO" . *amezo-name*) ("URLBASE" . *urlbase*) ("ADMIN" . *admin-name*)
    ("POST_INTERVAL" . *post-interval*) ("GLOBAL_WINDOW" . *global-window*)
    ("MAX_THREADS" . *max-threads*) ("PAGE_CACHE" . *page-cache*)
    ("MAX_POST_BYTES" . *max-post-bytes*) ("SUBJ_MAX" . *subj-max*)
    ("NAME_MAX" . *name-max*) ("MAIL_MAX" . *mail-max*) ("COMM_MAX" . *comm-max*)
    ("COMM_LINES_MAX" . *comm-lines-max*) ("HASH_ITERATIONS" . *hash-iterations*)
    ("TRUSTED_PROXIES" . *trusted-proxies*) ("JUMP_ENABLED" . *jump-enabled*)
    ("ARCHIVE_QUIET_SECONDS" . *archive-quiet-seconds*)))

(defun load-config ()
  "config.ini を読み、検査を通った値だけを反映する (Python 版の起動時処理と同じ)。"
  (multiple-value-bind (values errors) (config-load (app-path "config.ini"))
    (dolist (e errors)
      (format *error-output* "amezo: config.ini の ~a (無視して、既定値を使います)~%" e))
    (dolist (kv values)
      (let ((var (cdr (assoc (car kv) *config-vars* :test #'string=))))
        (when var (set var (cdr kv)))))
    (when (file-regular-p (app-path "config.php"))
      (format *error-output* "amezo: config.php は読み込みません (実行される形式の設定は使いません)。config.ini に移してください~%"))
    values))
